# Secrets
.env
backend/.env
# Indeholder klartekst-adgangskoder til prod-infrastruktur (proxy/appserver) —
# må aldrig committes. Se filens eget afsnit 6 ("Adgang").
movie-laces-dk-runbook.md
*-runbook.md

# Python
backend/__pycache__/
backend/**/__pycache__/
backend/.venv/
backend/venv/
*.pyc

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.cert/

# OS/editor
.DS_Store
Thumbs.db
.vscode/

# Produktion: OTA-deploy restart-trigger (se scripts/moviedb-deploy-restart.path)
.deploy-restart-trigger

