# Kopiér denne fil til .env og udfyld. .env er git-ignoreret (se CLAUDE.md regel 6).

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=moviedb

# TMDb API Read Access Token (v4 auth), se MOVIE_API_REFERENCE.md
TMDB_API_TOKEN=

# Valgfri: kun hvis den valgte UPC-udbyder kræver nøgle, se MOVIE_API_REFERENCE.md
UPC_API_KEY=

LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
