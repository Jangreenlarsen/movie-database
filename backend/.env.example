# Kopiér denne fil til .env og udfyld. .env er git-ignoreret (se CLAUDE.md regel 6).

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=moviedb

# TMDb API Read Access Token (v4 auth), se MOVIE_API_REFERENCE.md
TMDB_API_TOKEN=

# Valgfri: kun hvis den valgte UPC-udbyder kræver nøgle, se MOVIE_API_REFERENCE.md
UPC_API_KEY=

# Valgfri: Discogs personal access token (https://www.discogs.com/settings/developers) —
# bruges som fallback-stregkodeopslag når UPCitemdb ikke finder et match. Virker også uden
# token (lavere rate-limit: 25 req/min i stedet for 60), se MOVIE_API_REFERENCE.md
DISCOGS_TOKEN=

LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Generér en unik hemmelighed pr. miljø, fx: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Sæt til true når backend kører bag HTTPS i produktion (kræves for at browseren sender secure cookies)
COOKIE_SECURE=false

# Valgfri: kun relevant i produktion (se DEPLOYMENT.md) — sti til OTA-opdaterings-scriptet
# og dets log. Default matcher den faktiske produktionsserver, ingen grund til at ændre
# medmindre serveren sættes op med en anden mappestruktur.
# DEPLOY_SCRIPT_PATH=/opt/moviedb-deploy.sh
# DEPLOY_LOG_PATH=/opt/moviedb-deploy.log
